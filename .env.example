# Copy to .env and fill in. EXPO_PUBLIC_* values are bundled into the app, so only
# put non-secret values here (Firebase web config is safe to expose; secure it with rules).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# URL of the Express backend. Android emulator: http://10.0.2.2:4000, physical phone: http://<your-pc-ip>:4000
EXPO_PUBLIC_API_URL=http://localhost:4000
